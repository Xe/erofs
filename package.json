{
  "name": "@xe/erofs",
  "version": "0.1.0",
  "description": "erofs driver for fs.FS",
  "homepage": "https://github.com/Xe/erofs#readme",
  "bugs": {
    "url": "https://github.com/Xe/erofs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xe/erofs.git"
  },
  "license": "CC0-1.0",
  "author": "Xe Iaso <me@xeiaso.net>",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "go test ./...",
    "prepare": "husky",
    "ci": "npm run ci:go && npm run ci:zstd",
    "ci:go": "act -P ubuntu-24.04=ghcr.io/catthehacker/ubuntu:act-24.04 -j go_build --matrix os:ubuntu-24.04 --matrix go_version:stable",
    "ci:zstd": "act -P ubuntu-24.04=ghcr.io/catthehacker/ubuntu:act-24.04 -j zstd_image --container-options \"--privileged\""
  },
  "lint-staged": {
    "*.go": "go tool goimports -w"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "semantic-release": "^25.0.3"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/github",
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json",
            "package-lock.json"
          ],
          "message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}"
        }
      ]
    ]
  }
}